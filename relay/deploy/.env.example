# Copie para .env (não vai para o Git).

# Senha de admin inicial (opcional). Vazia: uma aleatória aparece em `docker compose logs capturax-signal`.
CAPTURAX_ADMIN_PASSWORD=

# DuckDNS (opcional, com --profile duckdns): só o nome (ex.: "meucapturax" para meucapturax.duckdns.org).
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
